# Configure real values securely in Vercel Project Settings > Environment Variables.
# Never commit real connection strings, passwords, device keys or tokens.
DATABASE_URL=
SETUP_KEY=
COOKIE_SECURE=1

# Firebase server integration (enable explicitly with DATABASE_PROVIDER=firestore).
FIREBASE_PROJECT_ID=gaming-zone-software
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Only needed for Realtime Database; use the exact console URL.
FIREBASE_DATABASE_URL=
# Set this only after Firestore server credentials and indexes/rules are configured.
# Explicit firestore selection takes precedence over DATABASE_URL.
# DATABASE_PROVIDER=firestore
# Optional: named Firestore database; default is (default).
# FIREBASE_DATABASE_ID=(default)

# Natural Urdu female voice: enable Cloud Text-to-Speech and billing first.
# Uses the same securely configured Firebase service account.
# VOICE_PROVIDER=google
# Optional: an exact FEMALE Urdu voice name returned by Google's /v1/voices API.
# URDU_VOICE_NAME=

# Real AI chat: add the actual Google AI Studio key securely in Vercel, never here.
GEMINI_API_KEY=
# Optional exact model ID. If absent, select an available stable Flash model.
# GEMINI_MODEL=
